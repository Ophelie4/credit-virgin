# Tiger Data: paste TIMESCALE_SERVICE_URL from your tiger-cloud-*-credentials.env
TIMESCALE_SERVICE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Gemini: from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth0 (leave empty until wired; app then runs as a demo applicant)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Where the frontend lives (used for share links)
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
